BLOB_READ_WRITE_TOKEN=
# Production has migrated to Convex. Use an isolated backend for development.
NEXT_PUBLIC_ATTENDANCE_BACKEND=convex
# Freeze the current deployment's legacy writes during cutover. Old deployments
# must also lose writer access; this flag alone cannot freeze immutable URLs.
ATTENDANCE_BLOB_WRITES_DISABLED=1
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Server-only. Generate a distinct random key for every environment and set it
# in BOTH Next and Convex. Never use a Convex deploy/admin key here.
ATTENDANCE_GATEWAY_KEY=
ATTENDANCE_GATEWAY_AUDIENCE=
# Configure JWT_PRIVATE_KEY and JWKS in Convex only, following Convex Auth setup.
